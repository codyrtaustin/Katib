#!/bin/bash
# Katib Application Launcher
# Shell script launcher that ensures proper GUI display on macOS

# Set up environment
export PATH="/Library/Frameworks/Python.framework/Versions/3.11/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:$PATH"
export PYTHONUNBUFFERED=1

# Find the Katib directory
KATIB_DIR="$HOME/Katib"

# Use Python 3.11 which has PySide6 installed
PYTHON3="/Library/Frameworks/Python.framework/Versions/3.11/bin/python3"

# Prefer the PySide6 version (katib_qt.py) over tkinter version (katib.py)
if [ -f "$KATIB_DIR/katib_qt.py" ]; then
    KATIB_SCRIPT="$KATIB_DIR/katib_qt.py"
elif [ -f "$KATIB_DIR/katib.py" ]; then
    KATIB_SCRIPT="$KATIB_DIR/katib.py"
else
    osascript -e 'display dialog "Error: Could not find katib_qt.py or katib.py" buttons {"OK"} default button "OK" with icon stop'
    exit 1
fi

# Change to Katib directory
cd "$KATIB_DIR" || exit 1

# Run the application - use exec to replace this process
exec "$PYTHON3" "$KATIB_SCRIPT"
